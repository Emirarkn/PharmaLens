{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Ingestion batch manifest",
  "type": "object",
  "required": ["batch_id", "dataset", "source", "file_path", "sha256", "received_at_utc", "period_start",
               "period_end", "schema_version", "revision", "supersedes_batch_id", "confidentiality",
               "license_id", "owner", "row_count", "available_at", "availability_mode"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 3},
    "dataset": {"type": "string"},
    "source": {"type": "string"},
    "file_path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "received_at_utc": {"type": "string", "format": "date-time"},
    "period_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "period_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "schema_version": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_batch_id": {"type": ["string", "null"]},
    "confidentiality": {"enum": ["synthetic", "internal", "restricted", "confidential"]},
    "license_id": {"type": "string"},
    "owner": {"type": "string"},
    "row_count": {"type": ["integer", "null"], "minimum": 0},
    "available_at": {"type": "string", "format": "date-time"},
    "availability_mode": {"enum": ["batch", "retrospective_lag"]},
    "retrospective_lag_days": {"type": ["integer", "null"], "minimum": 0},
    "synthetic": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
